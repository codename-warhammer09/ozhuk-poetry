# ==========================================
# 1. Critical Secrets & Environments
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key
token.json

# ==========================================
# 2. Claude Code, Agent Memory & Skills
# ==========================================
# Local Claude configurations & caches
.claude/settings.local.json
.claude/history/
.claude/transcripts/
.claude/hooks/*.local.sh
.claude.json

# Allow shared skill definitions and project rules to be tracked
!.claude/skills/
!.claude/settings.json
!CLAUDE.md
!SKILLS.md

# ==========================================
# 3. Python & uv Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments (uv / venv)
.venv/
env/
venv/
ENV/

# ==========================================
# 4. Streamlit & Web Caches
# ==========================================
.streamlit/secrets.toml
.streamlit/config.toml
*.log

# ==========================================
# 5. Local Vector DBs & Temporary Assets
# ==========================================
# Local ChromaDB, FAISS indices, or scraped caches
.chroma/
*.faiss
*.pkl
cache/
tmp/
temp/

# User uploads/test images (avoid bloating git)
uploads/*
!uploads/.gitkeep

# ==========================================
# 6. IDEs & OS Files
# ==========================================
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
*.swp
*~